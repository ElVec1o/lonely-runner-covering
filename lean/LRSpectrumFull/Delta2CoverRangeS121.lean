  · exact hcap_c45 i (by omega) c45 S hS hc
  exact hcap_c46 i (by omega) (by omega) S hS hc

end CRS121

set_option maxHeartbeats 1000000 in
set_option maxRecDepth 100000 in
/-- **Dense window at m = 121** (`2m+1 = 243`): every 121 distinct positive velocities
bounded by 242 meet the floor `1/122`.  Cover-capacity certificate: 47 parts, capacities
summing to 120 < 121, using 203 witness times (split style). -/
theorem dense_floor_m121_split (v : Fin 121 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 242) :
    1 / (122 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 120) (t := 47) (N := 203) v hv hinj
    (by simpa using hden) CRS121.pf CRS121.qf CRS121.hq_all CRS121.bf CRS121.hbad_all
    CRS121.Uf CRS121.cf CRS121.hcover_all CRS121.hcap_all CRS121.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
