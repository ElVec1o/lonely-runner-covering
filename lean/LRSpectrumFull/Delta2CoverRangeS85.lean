/-- **Dense window at m = 85** (`2m+1 = 171`): every 85 distinct positive velocities
bounded by 170 meet the floor `1/86`.  Cover-capacity certificate: 35 parts, capacities
summing to 84 < 85, using 138 witness times (split style). -/
theorem dense_floor_m85_split (v : Fin 85 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 170) :
    1 / (86 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 84) (t := 35) (N := 138) v hv hinj
    (by simpa using hden) CRS85.pf CRS85.qf CRS85.hq_all CRS85.bf CRS85.hbad_all
    CRS85.Uf CRS85.cf CRS85.hcover_all CRS85.hcap_all CRS85.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
