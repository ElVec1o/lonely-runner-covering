/-- **Dense window at m = 84** (`2m+1 = 169`): every 84 distinct positive velocities
bounded by 168 meet the floor `1/85`.  Cover-capacity certificate: 27 parts, capacities
summing to 83 < 84, using 146 witness times (split style). -/
theorem dense_floor_m84_split (v : Fin 84 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 168) :
    1 / (85 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 83) (t := 27) (N := 146) v hv hinj
    (by simpa using hden) CRS84.pf CRS84.qf CRS84.hq_all CRS84.bf CRS84.hbad_all
    CRS84.Uf CRS84.cf CRS84.hcover_all CRS84.hcap_all CRS84.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
