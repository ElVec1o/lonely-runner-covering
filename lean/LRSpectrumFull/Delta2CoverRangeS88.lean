/-- **Dense window at m = 88** (`2m+1 = 177`): every 88 distinct positive velocities
bounded by 176 meet the floor `1/89`.  Cover-capacity certificate: 32 parts, capacities
summing to 87 < 88, using 147 witness times (split style). -/
theorem dense_floor_m88_split (v : Fin 88 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 176) :
    1 / (89 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 87) (t := 32) (N := 147) v hv hinj
    (by simpa using hden) CRS88.pf CRS88.qf CRS88.hq_all CRS88.bf CRS88.hbad_all
    CRS88.Uf CRS88.cf CRS88.hcover_all CRS88.hcap_all CRS88.hsum_all
