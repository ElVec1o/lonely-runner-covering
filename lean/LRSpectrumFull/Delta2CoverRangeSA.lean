/-- **Dense window at m = 62** (`2m+1 = 125`): every 62 distinct positive velocities
bounded by 124 meet the floor `1/63`.  Cover-capacity certificate: 44 parts, capacities
summing to 61 < 62, using 81 witness times (split style). -/
theorem dense_floor_m62_split (v : Fin 62 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 124) :
    1 / (63 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 61) (t := 44) (N := 81) v hv hinj
    (by simpa using hden) CRSA.pf CRSA.qf CRSA.hq_all CRSA.bf CRSA.hbad_all
    CRSA.Uf CRSA.cf CRSA.hcover_all CRSA.hcap_all CRSA.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
