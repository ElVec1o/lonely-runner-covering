/-- **Dense window at m = 80** (`2m+1 = 161`): every 80 distinct positive velocities
bounded by 160 meet the floor `1/81`.  Cover-capacity certificate: 28 parts, capacities
summing to 79 < 80, using 135 witness times (split style). -/
theorem dense_floor_m80_split (v : Fin 80 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 160) :
    1 / (81 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 79) (t := 28) (N := 135) v hv hinj
    (by simpa using hden) CRS80.pf CRS80.qf CRS80.hq_all CRS80.bf CRS80.hbad_all
    CRS80.Uf CRS80.cf CRS80.hcover_all CRS80.hcap_all CRS80.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
