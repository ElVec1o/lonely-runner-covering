/-- **Dense window at m = 100** (`2m+1 = 201`): every 100 distinct positive velocities
bounded by 200 meet the floor `1/101`.  Cover-capacity certificate: 39 parts, capacities
summing to 99 < 100, using 171 witness times (split style). -/
theorem dense_floor_m100_split (v : Fin 100 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 200) :
    1 / (101 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 99) (t := 39) (N := 171) v hv hinj
    (by simpa using hden) CRS100.pf CRS100.qf CRS100.hq_all CRS100.bf CRS100.hbad_all
    CRS100.Uf CRS100.cf CRS100.hcover_all CRS100.hcap_all CRS100.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
