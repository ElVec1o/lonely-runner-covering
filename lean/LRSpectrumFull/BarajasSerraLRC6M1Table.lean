/-- Unordered pairwise ANDs (with repetition) of a list. -/
def pairsUp : List Nat → List Nat
  | [] => []
  | b :: rest => (b :: rest).map (fun c => b &&& c) ++ pairsUp rest

/-- `a * x mod 98 ∈ [14, 84]`. -/
def win (a x : Nat) : Bool := Nat.ble 14 (a * x % 98) && Nat.ble (a * x % 98) 84

/-- `b` is a mask of witnesses for the residue `x`. -/
def goodM (b x : Nat) : Bool := Nat.blt b (2 ^ 98) && (List.range 98).all (fun a => !b.testBit a || win a x)

/-- Normalizing multiplier: an odd `s < 98`, `7 ∤ s`, with `s * r ≡ target (mod 98)`. -/
def invT (r target : Nat) : Nat :=
  ((List.range 98).find? (fun s => s * r % 98 == target && s % 2 == 1 && s % 7 != 0)).getD 0

