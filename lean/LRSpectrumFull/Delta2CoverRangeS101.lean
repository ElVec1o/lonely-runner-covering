/-- **Dense window at m = 101** (`2m+1 = 203`): every 101 distinct positive velocities
bounded by 202 meet the floor `1/102`.  Cover-capacity certificate: 37 parts, capacities
summing to 100 < 101, using 169 witness times (split style). -/
theorem dense_floor_m101_split (v : Fin 101 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 202) :
    1 / (102 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 100) (t := 37) (N := 169) v hv hinj
    (by simpa using hden) CRS101.pf CRS101.qf CRS101.hq_all CRS101.bf CRS101.hbad_all
    CRS101.Uf CRS101.cf CRS101.hcover_all CRS101.hcap_all CRS101.hsum_all
  norm_num at h
  exact h

