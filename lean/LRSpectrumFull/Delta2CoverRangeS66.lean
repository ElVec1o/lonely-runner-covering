/-- **Dense window at m = 66** (`2m+1 = 133`): every 66 distinct positive velocities
bounded by 132 meet the floor `1/67`.  Cover-capacity certificate: 25 parts, capacities
summing to 65 < 66, using 112 witness times (split style). -/
theorem dense_floor_m66_split (v : Fin 66 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 132) :
    1 / (67 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 65) (t := 25) (N := 112) v hv hinj
    (by simpa using hden) CRS66.pf CRS66.qf CRS66.hq_all CRS66.bf CRS66.hbad_all
    CRS66.Uf CRS66.cf CRS66.hcover_all CRS66.hcap_all CRS66.hsum_all
  norm_num at h
  exact h

