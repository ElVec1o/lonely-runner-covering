/-- **Dense window at m = 91** (`2m+1 = 183`): every 91 distinct positive velocities
bounded by 182 meet the floor `1/92`.  Cover-capacity certificate: 36 parts, capacities
summing to 90 < 91, using 149 witness times (split style). -/
theorem dense_floor_m91_split (v : Fin 91 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 182) :
    1 / (92 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 90) (t := 36) (N := 149) v hv hinj
    (by simpa using hden) CRS91.pf CRS91.qf CRS91.hq_all CRS91.bf CRS91.hbad_all
    CRS91.Uf CRS91.cf CRS91.hcover_all CRS91.hcap_all CRS91.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
