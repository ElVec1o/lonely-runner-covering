/-- **Dense window at m = 122** (`2m+1 = 245`): every 122 distinct positive velocities
bounded by 244 meet the floor `1/123`.  Cover-capacity certificate: 47 parts, capacities
summing to 121 < 122, using 202 witness times (split style). -/
theorem dense_floor_m122_split (v : Fin 122 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 244) :
    1 / (123 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 121) (t := 47) (N := 202) v hv hinj
    (by simpa using hden) CRS122.pf CRS122.qf CRS122.hq_all CRS122.bf CRS122.hbad_all
    CRS122.Uf CRS122.cf CRS122.hcover_all CRS122.hcap_all CRS122.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
