/-- **Dense window at m = 79** (`2m+1 = 159`): every 79 distinct positive velocities
bounded by 158 meet the floor `1/80`.  Cover-capacity certificate: 36 parts, capacities
summing to 78 < 79, using 123 witness times (split style). -/
theorem dense_floor_m79_split (v : Fin 79 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 158) :
    1 / (80 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 78) (t := 36) (N := 123) v hv hinj
    (by simpa using hden) CRS79.pf CRS79.qf CRS79.hq_all CRS79.bf CRS79.hbad_all
    CRS79.Uf CRS79.cf CRS79.hcover_all CRS79.hcap_all CRS79.hsum_all
  norm_num at h
  exact h

