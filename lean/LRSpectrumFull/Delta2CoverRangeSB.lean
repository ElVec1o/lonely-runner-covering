/-- **Dense window at m = 64** (`2m+1 = 129`): every 64 distinct positive velocities
bounded by 128 meet the floor `1/65`.  Cover-capacity certificate: 23 parts, capacities
summing to 63 < 64, using 108 witness times (split style). -/
theorem dense_floor_m64_split (v : Fin 64 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 128) :
    1 / (65 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 63) (t := 23) (N := 108) v hv hinj
    (by simpa using hden) CRSB.pf CRSB.qf CRSB.hq_all CRSB.bf CRSB.hbad_all
    CRSB.Uf CRSB.cf CRSB.hcover_all CRSB.hcap_all CRSB.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
