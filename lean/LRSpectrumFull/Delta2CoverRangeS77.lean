/-- **Dense window at m = 77** (`2m+1 = 155`): every 77 distinct positive velocities
bounded by 154 meet the floor `1/78`.  Cover-capacity certificate: 27 parts, capacities
summing to 76 < 77, using 130 witness times (split style). -/
theorem dense_floor_m77_split (v : Fin 77 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 154) :
    1 / (78 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 76) (t := 27) (N := 130) v hv hinj
    (by simpa using hden) CRS77.pf CRS77.qf CRS77.hq_all CRS77.bf CRS77.hbad_all
    CRS77.Uf CRS77.cf CRS77.hcover_all CRS77.hcap_all CRS77.hsum_all
  norm_num at h
  exact h

