/-- **Dense window at m = 92** (`2m+1 = 185`): every 92 distinct positive velocities
bounded by 184 meet the floor `1/93`.  Cover-capacity certificate: 37 parts, capacities
summing to 91 < 92, using 151 witness times (split style). -/
theorem dense_floor_m92_split (v : Fin 92 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 184) :
    1 / (93 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 91) (t := 37) (N := 151) v hv hinj
    (by simpa using hden) CRS92.pf CRS92.qf CRS92.hq_all CRS92.bf CRS92.hbad_all
    CRS92.Uf CRS92.cf CRS92.hcover_all CRS92.hcap_all CRS92.hsum_all
  norm_num at h
  exact h

