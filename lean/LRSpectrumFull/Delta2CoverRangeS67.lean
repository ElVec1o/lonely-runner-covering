/-- **Dense window at m = 67** (`2m+1 = 135`): every 67 distinct positive velocities
bounded by 134 meet the floor `1/68`.  Cover-capacity certificate: 26 parts, capacities
summing to 66 < 67, using 110 witness times (split style). -/
theorem dense_floor_m67_split (v : Fin 67 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 134) :
    1 / (68 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 66) (t := 26) (N := 110) v hv hinj
    (by simpa using hden) CRS67.pf CRS67.qf CRS67.hq_all CRS67.bf CRS67.hbad_all
    CRS67.Uf CRS67.cf CRS67.hcover_all CRS67.hcap_all CRS67.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
