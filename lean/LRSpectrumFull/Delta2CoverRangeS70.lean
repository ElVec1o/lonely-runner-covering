/-- **Dense window at m = 70** (`2m+1 = 141`): every 70 distinct positive velocities
bounded by 140 meet the floor `1/71`.  Cover-capacity certificate: 25 parts, capacities
summing to 69 < 70, using 118 witness times (split style). -/
theorem dense_floor_m70_split (v : Fin 70 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 140) :
    1 / (71 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 69) (t := 25) (N := 118) v hv hinj
    (by simpa using hden) CRS70.pf CRS70.qf CRS70.hq_all CRS70.bf CRS70.hbad_all
    CRS70.Uf CRS70.cf CRS70.hcover_all CRS70.hcap_all CRS70.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
