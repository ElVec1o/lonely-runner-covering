  · exact hcap_c44 i (by omega) c44 S hS hc
  by_cases c45 : i.val < 46
  · exact hcap_c45 i (by omega) c45 S hS hc
  by_cases c46 : i.val < 47
  · exact hcap_c46 i (by omega) c46 S hS hc
  exact hcap_c47 i (by omega) (by omega) S hS hc

end CRS124

set_option maxHeartbeats 1000000 in
set_option maxRecDepth 100000 in
/-- **Dense window at m = 124** (`2m+1 = 249`): every 124 distinct positive velocities
bounded by 248 meet the floor `1/125`.  Cover-capacity certificate: 48 parts, capacities
summing to 123 < 124, using 204 witness times (split style). -/
theorem dense_floor_m124_split (v : Fin 124 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 248) :
    1 / (125 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 123) (t := 48) (N := 204) v hv hinj
    (by simpa using hden) CRS124.pf CRS124.qf CRS124.hq_all CRS124.bf CRS124.hbad_all
    CRS124.Uf CRS124.cf CRS124.hcover_all CRS124.hcap_all CRS124.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
