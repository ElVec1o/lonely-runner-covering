/-- **Dense window at m = 97** (`2m+1 = 195`): every 97 distinct positive velocities
bounded by 194 meet the floor `1/98`.  Cover-capacity certificate: 33 parts, capacities
summing to 96 < 97, using 175 witness times (split style). -/
theorem dense_floor_m97_split (v : Fin 97 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 194) :
    1 / (98 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 96) (t := 33) (N := 175) v hv hinj
    (by simpa using hden) CRS97.pf CRS97.qf CRS97.hq_all CRS97.bf CRS97.hbad_all
    CRS97.Uf CRS97.cf CRS97.hcover_all CRS97.hcap_all CRS97.hsum_all
  norm_num at h
  exact h

