/-- **Dense window at m = 93** (`2m+1 = 187`): every 93 distinct positive velocities
bounded by 186 meet the floor `1/94`.  Cover-capacity certificate: 31 parts, capacities
summing to 92 < 93, using 160 witness times (split style). -/
theorem dense_floor_m93_split (v : Fin 93 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 186) :
    1 / (94 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 92) (t := 31) (N := 160) v hv hinj
    (by simpa using hden) CRS93.pf CRS93.qf CRS93.hq_all CRS93.bf CRS93.hbad_all
    CRS93.Uf CRS93.cf CRS93.hcover_all CRS93.hcap_all CRS93.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
