    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 218) :
    1 / (110 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 108) (t := 42) (N := 182) v hv hinj
    (by simpa using hden) CRS109.pf CRS109.qf CRS109.hq_all CRS109.bf CRS109.hbad_all
    CRS109.Uf CRS109.cf CRS109.hcover_all CRS109.hcap_all CRS109.hsum_all
