/-- **Dense window at m = 72** (`2m+1 = 145`): every 72 distinct positive velocities
bounded by 144 meet the floor `1/73`.  Cover-capacity certificate: 26 parts, capacities
summing to 71 < 72, using 122 witness times (split style). -/
theorem dense_floor_m72_split (v : Fin 72 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 144) :
    1 / (73 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 71) (t := 26) (N := 122) v hv hinj
    (by simpa using hden) CRS72.pf CRS72.qf CRS72.hq_all CRS72.bf CRS72.hbad_all
    CRS72.Uf CRS72.cf CRS72.hcover_all CRS72.hcap_all CRS72.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
