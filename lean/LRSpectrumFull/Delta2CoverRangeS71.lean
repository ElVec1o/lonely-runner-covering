/-- **Dense window at m = 71** (`2m+1 = 143`): every 71 distinct positive velocities
bounded by 142 meet the floor `1/72`.  Cover-capacity certificate: 26 parts, capacities
summing to 70 < 71, using 120 witness times (split style). -/
theorem dense_floor_m71_split (v : Fin 71 → ℤ) (hv : ∀ i, 0 < v i)
    (hinj : Function.Injective fun i => (v i).toNat)
    (hden : ∀ i, (v i).toNat ∈ Finset.Icc 1 142) :
    1 / (72 : ℝ) ≤ ML v := by
  have h := floor_of_cover_capacity (k := 70) (t := 26) (N := 120) v hv hinj
    (by simpa using hden) CRS71.pf CRS71.qf CRS71.hq_all CRS71.bf CRS71.hbad_all
    CRS71.Uf CRS71.cf CRS71.hcover_all CRS71.hcap_all CRS71.hsum_all
  norm_num at h
  exact h

end LRSpectrumFull
